# Copy to .env and `set -a; source .env; set +a` (or export manually). All optional for local dev.
JWT_SECRET=dev-only-change-me-hackathon-jwt-secret-0123456789
JWT_EXPIRES_IN_SECONDS=86400

# Only used with: SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/hackathon
DB_USER=hackathon
DB_PASSWORD=hackathon
